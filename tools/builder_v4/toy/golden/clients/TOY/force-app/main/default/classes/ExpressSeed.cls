/**
 * EXPRESS seed loader, entry points. Generated by build_setup_seed.py; do not hand-edit.
 *   ExpressSeed.checkSetup();   // prints SETUP OK or throws SETUP INCOMPLETE / ALREADY SEEDED
 *   ExpressSeed.run();          // prechecks, bypass on, then one Batch job per plan step
 * The plan (steps, columns, prechecks, expected counts) is the SEED_PLAN static resource.
 */
public without sharing class ExpressSeed {
    public class SetupException extends Exception {}

    public static final String PLAN_RESOURCE = 'SEED_PLAN';
    public static final String PERMSET = 'EXPRESS_Seed_Admin';
    @TestVisible static Map<String, Object> planOverride;
    @TestVisible static Map<String, String> resourceOverride;
    static Map<String, Object> cachedPlan;

    public static Map<String, Object> plan() {
        if (planOverride != null) { return planOverride; }
        if (cachedPlan == null) {
            cachedPlan = (Map<String, Object>) JSON.deserializeUntyped(body(PLAN_RESOURCE));
        }
        return cachedPlan;
    }

    public static String body(String resourceName) {
        if (resourceOverride != null && resourceOverride.containsKey(resourceName)) {
            return resourceOverride.get(resourceName);
        }
        List<StaticResource> srs = [SELECT Body FROM StaticResource WHERE Name = :resourceName LIMIT 1];
        if (srs.isEmpty()) {
            throw new SetupException('SETUP INCOMPLETE: static resource ' + resourceName
                + ' is missing. Deploy this client folder (cd clients/<Code>; sf project deploy start).');
        }
        return srs[0].Body.toString();
    }

    public static List<Object> steps() { return (List<Object>) plan().get('steps'); }

    public static Map<String, Object> step(Integer n) {
        return (Map<String, Object>) steps()[n - 1];
    }

    // ------------------------------------------------------------ prechecks (spec 7.2)
    public static void checkSetup() {
        List<String> problems = setupProblems();
        if (!problems.isEmpty()) {
            String more = problems.size() > 1 ? ' (' + (problems.size() - 1) + ' more check(s) failing after this one)' : '';
            throw new SetupException(problems[0] + more);
        }
        System.debug(LoggingLevel.ERROR, 'SETUP OK: every precheck passed. NEXT: take the BEFORE census '
            + '(scripts/census.apex, MODE BEFORE), then run scripts/run-seed.apex.');
    }

    public static List<String> setupProblems() {
        List<String> p = new List<String>();
        Map<String, Object> req = (Map<String, Object>) plan().get('requires');
        Map<String, Schema.SObjectType> gd = Schema.getGlobalDescribe();
        Boolean acr = req.get('contacts_to_multiple_accounts') == true;
        // 1. every plan object exists and is createable
        for (Object o : (List<Object>) req.get('objects')) {
            String obj = (String) o;
            Schema.SObjectType t = gd.get(obj.toLowerCase());
            if (t == null) {
                if (acr && obj == 'AccountContactRelation') { continue; }   // named by check 4
                p.add('SETUP INCOMPLETE: object ' + obj + ' is not in this org. Enable the feature or license that provides it.');
            } else if (!t.getDescribe().isCreateable()) {
                p.add('SETUP INCOMPLETE: the running user cannot create ' + obj + '. Assign the ' + PERMSET + ' permission set.');
            }
        }
        // 2. record types exist, are active and available; person record types need Person Accounts
        Map<String, Object> rts = (Map<String, Object>) req.get('record_types');
        Set<String> person = new Set<String>();
        for (Object o : (List<Object>) req.get('person_record_types')) { person.add((String) o); }
        for (String obj : rts.keySet()) {
            Schema.SObjectType t = gd.get(obj.toLowerCase());
            if (t == null) { continue; }
            Schema.DescribeSObjectResult dr = t.getDescribe();
            Map<String, Schema.RecordTypeInfo> byDn = dr.getRecordTypeInfosByDeveloperName();
            for (Object v : (List<Object>) rts.get(obj)) {
                String dn = (String) v;
                if (person.contains(obj + '.' + dn) && !dr.fields.getMap().containsKey('ispersonaccount')) {
                    p.add('SETUP INCOMPLETE: Person Accounts are not enabled (needed for ' + obj + ' record type ' + dn + ').');
                    continue;
                }
                Schema.RecordTypeInfo rt = byDn.get(dn);
                if (rt == null) {
                    p.add('SETUP INCOMPLETE: record type ' + obj + '.' + dn + ' does not exist.');
                } else if (!rt.isActive()) {
                    p.add('SETUP INCOMPLETE: record type ' + obj + '.' + dn + ' is inactive.');
                } else if (!rt.isAvailable()) {
                    p.add('SETUP INCOMPLETE: record type ' + obj + '.' + dn + ' is not available to the running user. Add it to the profile or permission set.');
                }
            }
        }
        // 3. State and Country/Territory Picklists
        for (Object o : (List<Object>) req.get('state_country_fields')) {
            List<String> parts = ((String) o).split('\\.');
            Schema.SObjectType t = gd.get(parts[0].toLowerCase());
            if (t != null && !t.getDescribe().fields.getMap().containsKey(parts[1].toLowerCase())) {
                p.add('SETUP INCOMPLETE: State and Country/Territory Picklists are not enabled (' + o + ' is missing). Setup > State and Country/Territory Picklists.');
                break;
            }
        }
        // 4. Contacts to Multiple Accounts
        if (acr) {
            Schema.SObjectType t = gd.get('accountcontactrelation');
            if (t == null || !t.getDescribe().isCreateable()) {
                p.add('SETUP INCOMPLETE: Contacts to Multiple Accounts is not enabled. Setup > Account Settings > Allow users to relate a contact to multiple accounts.');
            }
        }
        // 5. audit fields createable = Set Audit Fields enabled and granted (D7)
        Map<String, Object> audit = (Map<String, Object>) req.get('audit_fields');
        for (String obj : audit.keySet()) {
            Schema.SObjectType t = gd.get(obj.toLowerCase());
            if (t == null) { continue; }
            Map<String, Schema.SObjectField> fm = t.getDescribe().fields.getMap();
            for (Object f : (List<Object>) audit.get(obj)) {
                Schema.SObjectField tok = fm.get(((String) f).toLowerCase());
                if (tok == null || !tok.getDescribe().isCreateable()) {
                    p.add('SETUP INCOMPLETE: ' + obj + '.' + f + ' is not createable, so Set Audit Fields is off or not granted. '
                        + 'Setup > User Interface > enable "Set Audit Fields upon Record Creation", then assign the '
                        + PERMSET + ' permission set (it grants Set Audit Fields).');
                }
            }
        }
        // 6. repo fields exist and are editable; plan resources present
        for (Object o : (List<Object>) req.get('repo_fields')) {
            List<String> parts = ((String) o).split('\\.');
            Schema.SObjectType t = gd.get(parts[0].toLowerCase());
            Schema.SObjectField tok = t == null ? null : t.getDescribe().fields.getMap().get(parts[1].toLowerCase());
            if (tok == null || !tok.getDescribe().isUpdateable()) {
                p.add('SETUP INCOMPLETE: repo field ' + o + ' is missing or not editable. Deploy this client folder and assign the ' + PERMSET + ' permission set.');
            }
        }
        if (resourceOverride == null) {
            Set<String> names = new Set<String>();
            for (Object so : steps()) {
                for (Object r : (List<Object>) ((Map<String, Object>) so).get('resources')) { names.add((String) r); }
            }
            Integer found = [SELECT COUNT() FROM StaticResource WHERE Name IN :names];
            if (found != names.size()) {
                p.add('SETUP INCOMPLETE: ' + (names.size() - found) + ' seed resource(s) missing. Deploy this client folder.');
            }
        }
        // 7. already seeded
        if (p.isEmpty() && req.get('already_seeded') != null) {
            Map<String, Object> a = (Map<String, Object>) req.get('already_seeded');
            List<String> keys = new List<String>();
            for (Object k : (List<Object>) a.get('keys')) { keys.add((String) k); }
            Integer hits = ExpressSeedBatch.countKeys((String) a.get('object'), (String) a.get('key_field'),
                (String) a.get('record_type'), keys);
            if (hits > 0) {
                p.add('ALREADY SEEDED: ' + hits + ' of the first ' + keys.size() + ' ' + a.get('object') + ' keys already exist for this user. '
                    + 'Run scripts/reset-data.apex (MODE DELETE) and verify with scripts/census.apex before seeding again.');
            }
        }
        return p;
    }

    // ------------------------------------------------------------ run
    public static Id run() {
        checkSetup();
        setBypass(true);
        String runId = String.valueOf(Datetime.now().getTime());
        Map<String, Object> s1 = step(1);
        System.debug(LoggingLevel.ERROR, 'SEED STARTED: run ' + runId + ', ' + steps().size()
            + ' steps. The verdict (SEED PASS or SEED FAIL) arrives by email and in Seed_Step_Result__c.');
        return Database.executeBatch(new ExpressSeedBatch(runId, 1), Integer.valueOf(s1.get('batch_size')));
    }

    public static void setBypass(Boolean enabled) {
        Migration_Settings__c ms = Migration_Settings__c.getOrgDefaults();
        ms.Bypass_Automation__c = enabled;
        upsert ms;
    }

    /** Called by the last step's finish(). Clears the bypass and states the verdict. */
    public static String complete(String runId) {
        setBypass(false);
        List<Seed_Step_Result__c> rs = [SELECT Step__c, Step_Name__c, Expected__c, Succeeded__c, Errors__c,
            Missing_Parent__c, Ambiguous_Parent__c, Failed_Batches__c, Owners_Remapped__c, Sample_Errors__c
            FROM Seed_Step_Result__c WHERE Run_Id__c = :runId ORDER BY Step__c];
        String v = verdict(rs, steps().size());
        String body = v + '\n\nSTEP / EXPECTED / SUCCEEDED / ERRORS / MISSING PARENT / AMBIGUOUS PARENT / FAILED BATCHES / OWNERS REMAPPED\n';
        for (Seed_Step_Result__c r : rs) {
            body += r.Step_Name__c + ' / ' + r.Expected__c + ' / ' + r.Succeeded__c + ' / ' + r.Errors__c + ' / '
                + r.Missing_Parent__c + ' / ' + r.Ambiguous_Parent__c + ' / ' + r.Failed_Batches__c + ' / '
                + r.Owners_Remapped__c + (String.isBlank(r.Sample_Errors__c) ? '' : '\n    ' + r.Sample_Errors__c) + '\n';
        }
        body += '\nBypass_Automation__c is now false. Run scripts/census.apex (MODE AFTER) to verify counts.';
        System.debug(LoggingLevel.ERROR, body);
        try {
            Messaging.SingleEmailMessage m = new Messaging.SingleEmailMessage();
            m.setTargetObjectId(UserInfo.getUserId());
            m.setSaveAsActivity(false);
            m.setSubject('EXPRESS seed run ' + runId + ': ' + v.substringBefore(':'));
            m.setPlainTextBody(body);
            Messaging.sendEmail(new List<Messaging.SingleEmailMessage>{ m });
        } catch (Exception e) {
            System.debug(LoggingLevel.ERROR, 'Email not sent (' + e.getMessage() + '). Query Seed_Step_Result__c for the verdict.');
        }
        return v;
    }

    /** SEED PASS only when every step ran, success = expected, and every error counter is 0 (#46). */
    public static String verdict(List<Seed_Step_Result__c> rs, Integer stepCount) {
        if (rs.size() != stepCount) {
            return 'SEED FAIL: ' + rs.size() + ' of ' + stepCount + ' steps recorded a result.';
        }
        for (Seed_Step_Result__c r : rs) {
            if (r.Succeeded__c != r.Expected__c || r.Errors__c != 0 || r.Missing_Parent__c != 0
                    || r.Ambiguous_Parent__c != 0 || r.Failed_Batches__c != 0) {
                return 'SEED FAIL: first failing step ' + r.Step_Name__c + ' (expected ' + r.Expected__c
                    + ', succeeded ' + r.Succeeded__c + ').';
            }
        }
        return 'SEED PASS: ' + stepCount + ' of ' + stepCount + ' steps, every success equals expected, every error counter 0.';
    }
}
