/**
 * One Batch job per plan step, chained from finish(). Generated by build_setup_seed.py.
 * Parents resolve per batch by natural key, scoped to records the running user created,
 * so no key map crosses jobs (spec 7.1).
 */
public without sharing class ExpressSeedBatch implements Database.Batchable<String>, Database.Stateful {
    public String runId;
    public Integer stepNo;
    public List<String> headers;
    public Integer succeeded = 0;
    public Integer errors = 0;
    public Integer missingParent = 0;
    public Integer ambiguousParent = 0;
    public Integer ownersRemapped = 0;
    public List<String> samples = new List<String>();
    public String startError;

    public ExpressSeedBatch(String runId, Integer stepNo) {
        this.runId = runId;
        this.stepNo = stepNo;
    }

    public Iterable<String> start(Database.BatchableContext bc) {
        // A failure here would skip finish(), stop the chain and strand the bypass ON.
        // So it is caught, recorded, and finish() ends the run with SEED FAIL.
        List<String> rows = new List<String>();
        try {
            Map<String, Object> s = ExpressSeed.step(stepNo);
            for (Object r : (List<Object>) s.get('resources')) {
                List<String> ls = ExpressCsv.lines(ExpressSeed.body((String) r));
                if (ls.isEmpty()) { continue; }
                if (headers == null) { headers = ExpressCsv.parseLine(ls[0]); }
                for (Integer i = 1; i < ls.size(); i++) { rows.add(ls[i]); }
            }
        } catch (Exception e) {
            startError = e.getTypeName() + ': ' + e.getMessage();
            addSample('start failed: ' + startError);
            return new List<String>();
        }
        return rows;
    }

    public void execute(Database.BatchableContext bc, List<String> scope) {
        Map<String, Object> s = ExpressSeed.step(stepNo);
        String objectApi = (String) s.get('object');
        Boolean isUpdate = s.get('op') == 'update';
        Schema.SObjectType sType = Schema.getGlobalDescribe().get(objectApi.toLowerCase());
        Schema.DescribeSObjectResult dr = sType.getDescribe();
        Map<String, Schema.SObjectField> fm = dr.fields.getMap();
        Map<String, Integer> col = new Map<String, Integer>();
        for (Integer i = 0; i < headers.size(); i++) { col.put(headers[i], i); }
        List<List<String>> rows = new List<List<String>>();
        for (String l : scope) { rows.add(ExpressCsv.parseLine(l)); }
        List<Object> cols = (List<Object>) s.get('columns');
        Id uid = UserInfo.getUserId();

        // resolve every lookup column for this scope: header -> value -> ids
        Map<String, Map<String, List<Id>>> resolved = new Map<String, Map<String, List<Id>>>();
        for (Object co : cols) {
            Map<String, Object> c = (Map<String, Object>) co;
            String kind = (String) c.get('kind');
            String h = (String) c.get('header');
            if (kind == 'LOOKUP') {
                Set<String> keys = colValues(rows, col.get(h));
                String tgt = (String) c.get('target');
                String kf = (String) c.get('key_field');
                resolved.put(h, resolveKeys(tgt, kf, keyRecordType(tgt, kf), keys));
            } else if (kind == 'POLY_TYPE') {
                String keyH = (String) c.get('rel') + '.Key';
                Map<String, Set<String>> byType = new Map<String, Set<String>>();
                for (List<String> r : rows) {
                    String ty = val(r, col.get(h));
                    String k = val(r, col.get(keyH));
                    if (ty == '' || k == '') { continue; }
                    if (!byType.containsKey(ty)) { byType.put(ty, new Set<String>()); }
                    byType.get(ty).add(k);
                }
                for (String ty : byType.keySet()) {
                    Map<String, List<Id>> m = new Map<String, List<Id>>();
                    for (Map<String, Object> kr : keyRows(ty)) {
                        mergeInto(m, resolveKeys(ty, (String) kr.get('key_field'), (String) kr.get('record_type'), byType.get(ty)));
                    }
                    resolved.put(h + '|' + ty, m);
                }
            }
        }
        // update steps: find the row's own record by its natural key
        Map<String, List<Id>> selfIds = new Map<String, List<Id>>();
        Map<String, String> selfKeyField = new Map<String, String>();
        if (isUpdate) {
            for (Map<String, Object> kr : keyRows(objectApi)) {
                String kf = (String) kr.get('key_field');
                String rt = (String) kr.get('record_type');
                Set<String> keys = new Set<String>();
                for (List<String> r : rows) {
                    if (rt != null && val(r, col.get('RecordType.DeveloperName')) != rt) { continue; }
                    keys.add(val(r, col.get(kf)));
                }
                keys.remove('');
                Map<String, List<Id>> m = resolveKeys(objectApi, kf, rt, keys);
                for (String k : m.keySet()) { selfIds.put((rt == null ? '' : rt) + '|' + kf + '|' + k, m.get(k)); }
            }
        }

        Map<String, Schema.RecordTypeInfo> rtByDn = dr.getRecordTypeInfosByDeveloperName();
        List<SObject> recs = new List<SObject>();
        List<String> recLabel = new List<String>();
        Integer remapped = 0;
        for (List<String> r : rows) {
            SObject rec = sType.newSObject();
            Boolean skip = false;
            String label = r.isEmpty() ? '' : r[0];
            if (isUpdate) {
                Id selfId = null;
                for (Map<String, Object> kr : keyRows(objectApi)) {
                    String kf = (String) kr.get('key_field');
                    String rt = (String) kr.get('record_type');
                    if (rt != null && val(r, col.get('RecordType.DeveloperName')) != rt) { continue; }
                    List<Id> ids = selfIds.get((rt == null ? '' : rt) + '|' + kf + '|' + val(r, col.get(kf)));
                    if (ids == null || ids.isEmpty()) { continue; }
                    if (ids.size() > 1) { ambiguousParent++; skip = true; break; }
                    selfId = ids[0];
                }
                if (skip) { continue; }
                if (selfId == null) { missingParent++; continue; }
                rec.put('Id', selfId);
            }
            for (Object co : cols) {
                Map<String, Object> c = (Map<String, Object>) co;
                String kind = (String) c.get('kind');
                String h = (String) c.get('header');
                String v = val(r, col.get(h));
                if (kind == 'POLY_KEY') { continue; }
                if (isUpdate && (kind == 'RECORDTYPE' || (kind == 'FIELD' && c.get('self_ref') != true))) { continue; }
                if (v == '') { continue; }
                if (kind == 'RECORDTYPE') {
                    Schema.RecordTypeInfo rti = rtByDn.get(v);
                    if (rti != null) { rec.put('RecordTypeId', rti.getRecordTypeId()); }
                } else if (kind == 'OWNER') {
                    rec.put('OwnerId', uid);
                    String ownerField = (String) s.get('owner_field');
                    if (ownerField != null) { rec.put(ownerField, v); }
                    remapped++;
                } else if (kind == 'LOOKUP' || kind == 'POLY_TYPE') {
                    String key = kind == 'LOOKUP' ? v : val(r, col.get((String) c.get('rel') + '.Key'));
                    Map<String, List<Id>> m = resolved.get(kind == 'LOOKUP' ? h : h + '|' + v);
                    List<Id> ids = m == null ? null : m.get(key);
                    if (ids == null || ids.isEmpty()) { missingParent++; skip = true; break; }
                    if (ids.size() > 1) { ambiguousParent++; skip = true; break; }
                    rec.put((String) c.get('field'), ids[0]);
                } else {
                    String f = (String) c.get('field');
                    Schema.SObjectField tok = fm.get(f.toLowerCase());
                    if (tok == null) { errors++; addSample('column ' + h + ' is not a field on ' + objectApi); skip = true; break; }
                    rec.put(f, typed(tok.getDescribe().getType(), v));
                }
            }
            if (skip) { continue; }
            recs.add(rec);
            recLabel.add(label);
        }
        Database.DMLOptions dml = new Database.DMLOptions();
        dml.duplicateRuleHeader.allowSave = true;
        dml.optAllOrNone = false;
        List<Database.SaveResult> res = isUpdate ? Database.update(recs, dml) : Database.insert(recs, dml);
        for (Integer i = 0; i < res.size(); i++) {
            if (res[i].isSuccess()) { succeeded++; }
            else {
                errors++;
                Database.Error e = res[i].getErrors()[0];
                addSample(recLabel[i] + ': ' + e.getStatusCode() + ' ' + e.getMessage());
            }
        }
        ownersRemapped += remapped;
    }

    public void finish(Database.BatchableContext bc) {
        Map<String, Object> s = ExpressSeed.step(stepNo);
        Integer failedBatches = 0;
        if (bc != null) {
            AsyncApexJob j = [SELECT NumberOfErrors, ExtendedStatus FROM AsyncApexJob WHERE Id = :bc.getJobId()];
            failedBatches = j.NumberOfErrors == null ? 0 : j.NumberOfErrors;
            if (failedBatches > 0) { addSample('batch failure: ' + j.ExtendedStatus); }
        }
        insert new Seed_Step_Result__c(
            Name = (String) s.get('name'),
            Run_Id__c = runId,
            Step__c = stepNo,
            Step_Name__c = (String) s.get('name'),
            Object__c = (String) s.get('object'),
            Operation__c = (String) s.get('op'),
            Expected__c = Integer.valueOf(s.get('rows')),
            Succeeded__c = succeeded,
            Errors__c = errors,
            Missing_Parent__c = missingParent,
            Ambiguous_Parent__c = ambiguousParent,
            Failed_Batches__c = failedBatches,
            Owners_Remapped__c = ownersRemapped,
            Sample_Errors__c = String.join(samples, '\n'));
        if (startError != null) {
            ExpressSeed.complete(runId);         // stop the chain, clear the bypass, state SEED FAIL
            return;
        }
        if (stepNo < ExpressSeed.steps().size()) {
            // A test method may start only one batch job, so tests drive later steps directly.
            if (Test.isRunningTest()) { return; }
            Map<String, Object> nextStep = ExpressSeed.step(stepNo + 1);
            Database.executeBatch(new ExpressSeedBatch(runId, stepNo + 1), Integer.valueOf(nextStep.get('batch_size')));
        } else {
            ExpressSeed.complete(runId);
        }
    }

    // ------------------------------------------------------------ helpers
    void addSample(String m) { if (samples.size() < 3) { samples.add(m.left(1000)); } }

    static String val(List<String> r, Integer i) {
        return (i == null || i >= r.size() || r[i] == null) ? '' : r[i].trim();
    }

    static Set<String> colValues(List<List<String>> rows, Integer i) {
        Set<String> out = new Set<String>();
        for (List<String> r : rows) { String v = val(r, i); if (v != '') { out.add(v); } }
        return out;
    }

    static void mergeInto(Map<String, List<Id>> target, Map<String, List<Id>> m) {
        for (String k : m.keySet()) {
            if (!target.containsKey(k)) { target.put(k, new List<Id>()); }
            target.get(k).addAll(m.get(k));
        }
    }

    public static List<Map<String, Object>> keyRows(String obj) {
        List<Map<String, Object>> out = new List<Map<String, Object>>();
        for (Object o : (List<Object>) ExpressSeed.plan().get('keys')) {
            Map<String, Object> k = (Map<String, Object>) o;
            if (k.get('object') == obj) { out.add(k); }
        }
        return out;
    }

    static String keyRecordType(String obj, String keyField) {
        for (Map<String, Object> k : keyRows(obj)) {
            if (k.get('key_field') == keyField) { return (String) k.get('record_type'); }
        }
        return null;
    }

    /** value -> ids among records the running user created; 2+ ids means AMBIGUOUS_PARENT. */
    public static Map<String, List<Id>> resolveKeys(String obj, String keyField, String recordType, Set<String> keys) {
        Map<String, List<Id>> out = new Map<String, List<Id>>();
        if (keys == null || keys.isEmpty()) { return out; }
        Map<String, Object> binds = new Map<String, Object>{ 'keys' => keys, 'uid' => UserInfo.getUserId(), 'rt' => recordType };
        String q = 'SELECT Id, ' + keyField + ' FROM ' + obj + ' WHERE ' + keyField + ' IN :keys AND CreatedById = :uid'
            + (recordType == null ? '' : ' AND RecordType.DeveloperName = :rt');
        for (SObject so : Database.queryWithBinds(q, binds, AccessLevel.SYSTEM_MODE)) {
            String k = String.valueOf(so.get(keyField));
            if (!out.containsKey(k)) { out.put(k, new List<Id>()); }
            out.get(k).add(so.Id);
        }
        return out;
    }

    public static Integer countKeys(String obj, String keyField, String recordType, List<String> keys) {
        Integer n = 0;
        for (List<Id> ids : resolveKeys(obj, keyField, recordType, new Set<String>(keys)).values()) { n += ids.size(); }
        return n;
    }

    public static Object typed(Schema.DisplayType dt, String v) {
        if (dt == Schema.DisplayType.DATE) { return Date.valueOf(v); }
        if (dt == Schema.DisplayType.DATETIME) { return (Datetime) JSON.deserialize('"' + v + '"', Datetime.class); }
        if (dt == Schema.DisplayType.CURRENCY || dt == Schema.DisplayType.DOUBLE || dt == Schema.DisplayType.PERCENT) {
            return Decimal.valueOf(v);
        }
        if (dt == Schema.DisplayType.INTEGER) { return Integer.valueOf(v); }
        if (dt == Schema.DisplayType.LONG) { return Long.valueOf(v); }
        if (dt == Schema.DisplayType.BOOLEAN) { return v.equalsIgnoreCase('true'); }
        return v;
    }
}
